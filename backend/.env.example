# مۆنۆپۆلی هەولێر — Backend Environment Variables
# Copy this to .env for local development.
# On Railway, configure these variables in the Service Variables dashboard.
# NEVER commit .env with real credentials!

# ── Server Configuration ─────────────────────────────────────
PORT=3000
NODE_ENV=development # 'development' (local SQLite) or 'production' (Railway PostgreSQL)

# ── Database (PostgreSQL / SQLite) ───────────────────────────
# For Railway production, connect the PostgreSQL plugin:
# DATABASE_URL=postgresql://postgres:password@host:5432/railway
# For local development without PostgreSQL, leave DATABASE_URL unset to use SQLite:
DB_PATH=./data.db

# ── JWT Authentication ───────────────────────────────────────
# Generate a 32+ character random secret for production
JWT_SECRET=super_secret_jwt_key_hawler_monopoly_change_me_in_prod
JWT_EXPIRES_IN=7d

# ── File & Media Storage ─────────────────────────────────────
UPLOAD_DIR=./uploads
# Optional: S3 / Cloudflare R2 object storage credentials
# S3_BUCKET=hawler-monopoly-assets
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ── Rate Limiting & Security ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CORS_ORIGIN=*

# ── Push Notifications (Optional) ───────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

